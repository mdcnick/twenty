{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "src/*": ["./src/*"] }
  },
  "exclude": ["node_modules", "dist"]
}
